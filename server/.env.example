# WeOwnFeed (WOF) server settings. Copy to .env and fill in the keys:
#   cp .env.example .env
# .env is git-ignored; never commit real keys.

# --- DATABASE & INTERNAL AUTH ---
# Local run (python / uvicorn): PostgreSQL 16 + pgvector on localhost.
# docker compose overrides this and points the containers at the "postgres" service.
DATABASE_URL=postgresql://wof:change_me@localhost:5432/weownfeed
# Used by docker compose to create the database (must match DATABASE_URL above).
POSTGRES_USER=wof
POSTGRES_PASSWORD=change_me
POSTGRES_DB=weownfeed
# Shared secret of the internal ingest endpoint (POST /api/internal/ingest).
# Any long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(36))"
INGESTION_SECRET=change_me_to_a_long_random_string

# --- MODELS: NEBIUS TOKEN FACTORY (default) ---
# One OpenAI-compatible endpoint serves every model below (ai.py).
# FAST: the code calls this model with small limits (e.g. max_tokens=30), and
#   "thinking" models (Nemotron) return empty at that size, so use a
#   non-thinking Instruct model.
# REASONING: article chat, multi-source synthesis, daily digest; streams fine.
AI_BASE_URL=https://api.tokenfactory.nebius.com/v1/
AI_API_KEY=your_nebius_api_key_here
FAST_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional per-task overrides (defaults shown).
# SUMMARY_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B   # article summary + briefing
# TAG_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B       # category / subtopic labels
# WAI_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731          # WAI assistant
# LATEST_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731       # home "Latest developments" card

# --- MODELS: LOCAL OLLAMA (fallback) ---
# To use it, comment out the four Nebius lines above and uncomment these.
# The per-task models above must then also point to local models.
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# FAST_MODEL=qwen2.5:7b
# REASONING_MODEL=qwen2.5:7b

# --- ENRICHMENT PIPELINE (worker.py) ---
# nano (default): Nebius only, no local model. Nemotron-3-Nano writes the summary,
#   FAST_MODEL decides on-topic, Nano picks taxonomy labels (llm_enrichment.py).
# hybrid: local Laya SLM triage + FAST_MODEL (needs requirements-local.txt).
ENRICHMENT_ENGINE=nano
NANO_CONCURRENCY=4
# hybrid mode only:
LAYA_CONFIDENCE_THRESHOLD=0.65
LAYA_ON_TOPIC_THRESHOLD=0.40
# LAYA_MODEL_NAME=convaiinnovations/laya

# --- EMBEDDINGS (embedder.py) ---
# nebius (default): Qwen/Qwen3-Embedding-8B through the Nebius endpoint, multilingual.
# local: sentence-transformers/all-MiniLM-L6-v2 on this machine (384 dims, English
#   only, needs requirements-local.txt).
# After changing backend or dimension run: python migrate_embeddings.py --rebuild
EMBEDDING_BACKEND=nebius
EMBEDDING_DIM=1024
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# --- TAVILY: NEWS DISCOVERY & VERIFICATION ---
TAVILY_API_KEY=tvly-your_tavily_api_key_here
# Optional: several keys, comma separated. When one runs out of plan credits the
# next one takes over automatically (overrides TAVILY_API_KEY when set).
# TAVILY_API_KEYS=tvly-key-one,tvly-key-two
TAVILY_PROJECT=weownfeed
TAVILY_SEARCH_DEPTH=basic
# 1 = offline demo mode: no Tavily calls, answers from tests/fixtures (no credits).
TAVILY_MOCK=0

# --- DEMAND-DRIVEN INGESTION (query_templates.json) ---
# Automatic ingestion stops before the remaining Tavily plan credits (all keys)
# drop below this reserve, so verification and live demos keep working.
# Remaining credits = Tavily /usage (which can lag for hours) + our own logged spend.
TAVILY_CREDIT_RESERVE=150

# --- NETWORKING ---
# Where ingest_tavily.py and site_watcher.py post new articles.
API_INGEST_URL=http://localhost:8000/api/internal/ingest
# Web app origins allowed to call the API from a browser, comma separated
# (e.g. https://weownfeed.vercel.app). Empty: any localhost / 127.0.0.1 port,
# for local development only.
CORS_ORIGINS=
# Proxies whose X-Forwarded-For headers uvicorn trusts. Behind a reverse proxy
# (nginx, a load balancer) set this to the proxy's IP, otherwise every visitor
# looks like the proxy and shares one sign-in / sign-up rate limit.
FORWARDED_ALLOW_IPS=127.0.0.1
